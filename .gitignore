# Operating System Files
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
*.png
*.jpg
*.jpeg

# Secrets & Environment Variables (CRITICAL)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
credentials.json

# Node.js & Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python & Virtual Environments
__pycache__/
*.py[cod]
.venv/
env/
venv/
*.egg-info/

# Build & Test Artifacts
dist/
build/
coverage/
*.log

# Databases & Container Runtime Dumps
*.rdb
*.aof
pgdata/
mongo_data/
redis_data/

# IDE & Editor Configurations
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Obsidian Vault Caches (keep workspace transient out of git)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/
.obsidian/backlinks/

# Standalone Projects
# (Each project inside Projects/ maintains its own independent git repo)
Projects/*
!Projects/.gitkeep
!Projects/README.md

# Agent & AI Temp Artifacts
.system_generated/
*.tmp
